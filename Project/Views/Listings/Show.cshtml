@model CampusMarket.Models.Listing

@{ ViewBag.Title = "Afișare anunt"; }

<div class="d-flex justify-content-center gap-2">
    <a class="btn btn-outline-success" asp-controller="Listings" asp-action="Index">Afișare anunt</a>
    <a class="btn btn-outline-success" asp-controller="Listings" asp-action="New">Adaugă anunt</a>
</div>
<br/>
<div class="card">
    <div class="card-body">
        <h3 class="card-title alert-success py-3 px-3 rounded-2">@Model.Title</h3>
        <div class="card-text">Descrierea</div>
        @Model.Description
        <div class="d-flex justify-content-between flex-row mt-5">
            <div><i class="bi bi-globe"></i> Numele categoriei</div>
            @Model.Category.CategoryName
        </div>
    </div>
    <hr/>
    <div class="d-flex flex-row justify-content-between">
        <a asp-controller="Listings" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">Editează anuntul</a>
        <form method="post" asp-controller="Listings" asp-action="Delete" asp-route-id="@Model.Id">
            <button class="btn btn-danger" type="submit">Șterge anuntul</button>
        </form>
    </div>
</div>
<br/>
<br/>

@foreach (var rev in Model.Reviews)
{
    <div class="container">
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div>
                    <p>@rev.Content</p>
                    <small>@rev.Date</small>
                </div>
                <br>
                <div class="d-flex gap-2">
                    <div>
                        <a class="btn btn-outline-primary" asp-controller="Reviews" asp-action="Edit" asp-route-id="@rev.Id"><i class="bi bi-pencil-square"></i> Editează</a>
                    </div>
                    <div>
                        <form method="post" asp-controller="Reviews" asp-action="Delete" asp-route-id="@rev.Id">
                            <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Șterge</button>
                        </form>
                    </div>
                </div>
                <br/>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
}

<div class="container">
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <div class="card">
                <form method="post" asp-controller="Reviews" asp-action="New">
                    <div class="card-body">
                        <input type="hidden" name="ListingId" value="@Model.Id"/>
                        <label>Conținutul recenziei</label>
                        <br/>
                        <textarea class="form-control" name="Content"></textarea>
                        <br/>
                        <button class="btn btn-success" type="submit">Adaugă recenzia</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-2"></div>
    </div>
</div>
