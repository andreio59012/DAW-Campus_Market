@model CampusMarket.Models.Listing

@{ ViewBag.Title = "Adăugare anunt"; }

<h2 class="text-center mt-5">Adăugare anunt</h2>
<br/>
<div class="container mt-5">
    <div class="row">
        <div class="col-6 offset-3">
            <form method="post" asp-action="New" asp-controller="Listings">

                <div class="form-group">
                    <label asp-for="Title" class="form-label">Titlul anuntului</label>
                    <br />
                    <input asp-for="Title" class="form-control" />
                    <br /><br />
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">Descrierea anuntului</label>
                    <br />
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <br /><br />
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Selectați categoria</label>
                    <br />
                    <select asp-for="CategoryId" asp-items="Model.CategorySelection" class="form-select">
                        <option value="">Selectați categoria</option>
                    </select>
                    <br />
                </div>
                <button class="btn btn-success" type="submit">Adaugă anuntul</button>
            </form>
        </div>
    </div>
</div>
